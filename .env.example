# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/eventhub
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Password for the demo accounts created by `python manage.py seed_demo`
DEMO_PASSWORD=CHANGE_ME
# Optional: Google Places API (New) key for `manage.py import_google_places`
GOOGLE_MAPS_API_KEY=
# Optional: Gebeta Maps key for `manage.py import_gebeta_places`
GEBETA_API_KEY=
